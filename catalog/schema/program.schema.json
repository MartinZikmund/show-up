{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://showup.app/catalog/schema/program.schema.json",
  "title": "WorkoutProgram",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "revision", "name", "family", "description", "heroImage", "accentColor", "verification", "sources", "verifiedOn", "tracks"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "family": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "heroImage": { "type": ["string", "null"] },
    "accentColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "verification": { "enum": ["official", "community"] },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "confirms"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "confirms": { "type": "string" }
        }
      }
    },
    "verifiedOn": { "type": "string", "format": "date" },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "phases"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "phases": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "weeks"],
              "properties": {
                "name": { "type": "string" },
                "weeks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["days"],
                    "properties": {
                      "days": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 7,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["sessions"],
                          "properties": {
                            "sessions": {
                              "type": "array",
                              "minItems": 1,
                              "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": ["workoutId"],
                                "properties": {
                                  "workoutId": { "type": "string" },
                                  "alternates": { "type": ["array", "null"], "items": { "type": "string" } },
                                  "optional": { "type": "boolean", "default": false }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
