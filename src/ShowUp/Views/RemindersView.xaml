<local:RemindersViewBase
    x:Class="ShowUp.Views.RemindersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ShowUp.Controls"
    xmlns:local="using:ShowUp.Views"
    xmlns:markup="using:ShowUp.Markup"
    xmlns:vm="using:ShowUp.Core.ViewModels">

    <ScrollViewer>
        <StackPanel
            x:Name="ContentPanel"
            MaxWidth="640"
            Padding="{StaticResource PagePadding}"
            HorizontalAlignment="Left"
            Spacing="16">
            <Button
                Margin="-8,0,0,-8"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="RemindersBackButton"
                Command="{x:Bind ViewModel.GoBackCommand, Mode=OneWay}"
                Style="{StaticResource SubtleButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="12" Glyph="&#xE72B;" />
                    <TextBlock Text="{markup:Localize Key=Back}" />
                </StackPanel>
            </Button>

            <TextBlock
                AutomationProperties.AutomationId="RemindersTitle"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource SectionHeaderTextBlockStyle}"
                Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" />

            <InfoBar
                AutomationProperties.AutomationId="RemindersUnsupportedNotice"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsUnsupported, Mode=OneWay}"
                Message="{markup:Localize Key=ReminderUnsupported}"
                Severity="Informational" />

            <InfoBar
                AutomationProperties.AutomationId="RemindersPermissionNotice"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.PermissionDenied, Mode=OneWay}"
                Message="{markup:Localize Key=ReminderPermissionDenied}"
                Severity="Warning" />

            <TextBlock
                AutomationProperties.AutomationId="RemindersEmptyText"
                Foreground="{ThemeResource MutedTextBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{markup:Localize Key=ReminderEmpty}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

            <!--  Reminders  -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReminderItemViewModel">
                        <Border
                            Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        AutomationProperties.AutomationId="ReminderTime"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="{x:Bind TimeText}" />
                                    <ItemsRepeater ItemsSource="{x:Bind Days}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Horizontal" Spacing="4" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border
                                                    Padding="8,2"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    CornerRadius="{ThemeResource ControlCornerRadius}">
                                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <ToggleSwitch
                                        MinWidth="0"
                                        AutomationProperties.AutomationId="ReminderEnabledToggle"
                                        AutomationProperties.Name="{markup:Localize Key=ReminderEnabledName}"
                                        IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                        OffContent=""
                                        OnContent="" />
                                    <Button
                                        AutomationProperties.AutomationId="ReminderEditButton"
                                        AutomationProperties.Name="{markup:Localize Key=ReminderEditAction}"
                                        Command="{x:Bind EditCommand}"
                                        Style="{StaticResource SubtleButtonStyle}">
                                        <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                    </Button>
                                    <Button
                                        AutomationProperties.AutomationId="ReminderDeleteButton"
                                        AutomationProperties.Name="{markup:Localize Key=ReminderDelete}"
                                        Command="{x:Bind DeleteCommand}"
                                        Style="{StaticResource SubtleButtonStyle}">
                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  Editor  -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock
                        AutomationProperties.AutomationId="ReminderEditorTitle"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.EditorTitle, Mode=OneWay}" />
                    <TimePicker
                        AutomationProperties.AutomationId="ReminderTimePicker"
                        Header="{markup:Localize Key=ReminderTimeLabel}"
                        Time="{x:Bind ViewModel.EditTime, Mode=TwoWay}" />
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{markup:Localize Key=ReminderDaysLabel}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Weekdays, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    MinColumnSpacing="4"
                                    MinItemWidth="44"
                                    MinRowSpacing="4" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:WeekdayToggle">
                                    <ToggleButton
                                        MinWidth="44"
                                        Padding="0,6"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                        Content="{x:Bind Label}"
                                        IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            AutomationProperties.AutomationId="ReminderSaveButton"
                            Command="{x:Bind ViewModel.SaveCommand, Mode=OneWay}"
                            Content="{markup:Localize Key=Save}"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            AutomationProperties.AutomationId="ReminderCancelButton"
                            Command="{x:Bind ViewModel.CancelCommand}"
                            Content="{markup:Localize Key=Cancel}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button
                AutomationProperties.AutomationId="ReminderAddButton"
                Command="{x:Bind ViewModel.StartAddCommand, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="{markup:Localize Key=ReminderAdd}" />
                </StackPanel>
            </Button>

            <controls:ProGateHint
                Command="{x:Bind ViewModel.OpenProCommand}"
                Text="{markup:Localize Key=ReminderProLink}"
                Visibility="{x:Bind ViewModel.ShowGate, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</local:RemindersViewBase>
