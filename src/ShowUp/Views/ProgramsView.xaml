<local:ProgramsViewBase
    x:Class="ShowUp.Views.ProgramsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ShowUp.Controls"
    xmlns:local="using:ShowUp.Views"
    xmlns:markup="using:ShowUp.Markup"
    xmlns:vm="using:ShowUp.Core.ViewModels">

    <local:ProgramsViewBase.Resources>
        <DataTemplate x:Key="ProgramCardTemplate" x:DataType="vm:ProgramCardViewModel">
            <Button
                Padding="0"
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="{x:Bind AutomationId}"
                AutomationProperties.Name="{x:Bind AutomationName}"
                Click="Card_Click"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Style="{StaticResource CardButtonStyle}"
                Tag="{x:Bind}">
                <Border
                    Background="{ThemeResource CalendarCellBackgroundBrush}"
                    BorderBrush="{ThemeResource CalendarCellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <StackPanel Padding="8" Spacing="8">
                        <controls:ProgramHero
                            Height="160"
                            AccentColor="{x:Bind AccentColor}"
                            Family="{x:Bind Family}"
                            HeroImage="{x:Bind HeroImage}"
                            ProgramName="{x:Bind Name}"
                            TitleFontSize="30" />
                        <Grid Padding="4,0,4,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource MutedTextBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind SummaryText}"
                                TextTrimming="CharacterEllipsis" />
                            <Border
                                Grid.Column="1"
                                Padding="8,4"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                ToolTipService.ToolTip="{x:Bind VerificationTooltip}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon
                                        FontSize="12"
                                        Foreground="{ThemeResource MutedTextBrush}"
                                        Glyph="{x:Bind VerificationGlyph}" />
                                    <TextBlock
                                        Foreground="{ThemeResource MutedTextBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind VerificationText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>
    </local:ProgramsViewBase.Resources>

    <ScrollViewer>
        <StackPanel
            x:Name="ContentPanel"
            Padding="{StaticResource PagePadding}"
            Spacing="16">
            <TextBlock
                AutomationProperties.AutomationId="ProgramsHeader"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource SectionHeaderTextBlockStyle}"
                Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" />

            <!--  The user's own programs (Pro to build; still listed after a lapse)  -->
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="MySchedulesHeader"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{markup:Localize Key=MySchedulesHeader}" />
                    <Button
                        Grid.Column="1"
                        AutomationProperties.AutomationId="NewScheduleButton"
                        Command="{x:Bind ViewModel.NewScheduleCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE710;" />
                            <TextBlock Text="{markup:Localize Key=NewSchedule}" />
                        </StackPanel>
                    </Button>
                </Grid>
                <controls:ProGateHint
                    Command="{x:Bind ViewModel.OpenProCommand}"
                    Text="{markup:Localize Key=ProCustomSchedulesLink}"
                    Visibility="{x:Bind ViewModel.ShowScheduleGate, Mode=OneWay}" />
                <TextBlock
                    AutomationProperties.AutomationId="MySchedulesEmpty"
                    Foreground="{ThemeResource MutedTextBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{markup:Localize Key=MySchedulesEmpty}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind local:ProgramsView.Not(ViewModel.HasCustomPrograms), Mode=OneWay}" />
                <ItemsRepeater ItemTemplate="{StaticResource ProgramCardTemplate}" ItemsSource="{x:Bind ViewModel.CustomPrograms, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="16"
                            MinItemWidth="280"
                            MinRowSpacing="16" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>

            <TextBlock
                AutomationProperties.AutomationId="CatalogHeader"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{markup:Localize Key=CatalogHeader}" />

            <Grid
                x:Name="FilterGrid"
                ColumnSpacing="12"
                RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <AutoSuggestBox
                    x:Name="FilterBox"
                    AutomationProperties.AutomationId="ProgramsFilterBox"
                    AutomationProperties.Name="{markup:Localize Key=ProgramsSearchPlaceholder}"
                    PlaceholderText="{markup:Localize Key=ProgramsSearchPlaceholder}"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.Filter, Mode=TwoWay}" />
                <ComboBox
                    x:Name="FamilyPicker"
                    Grid.Column="1"
                    MinWidth="200"
                    AutomationProperties.AutomationId="ProgramsFamilyPicker"
                    AutomationProperties.Name="{markup:Localize Key=ProgramsFamilyPicker}"
                    DisplayMemberPath="Display"
                    ItemsSource="{x:Bind ViewModel.FamilyOptions, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedFamilyOption, Mode=TwoWay}" />
            </Grid>

            <ItemsRepeater ItemTemplate="{StaticResource ProgramCardTemplate}" ItemsSource="{x:Bind ViewModel.Programs, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="16"
                        MinItemWidth="280"
                        MinRowSpacing="16" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>

            <TextBlock
                AutomationProperties.AutomationId="ProgramsNoMatches"
                Foreground="{ThemeResource MutedTextBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{markup:Localize Key=ProgramsNoMatches}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasNoMatches, Mode=OneWay}" />

            <TextBlock
                Margin="0,8,0,0"
                AutomationProperties.AutomationId="ProgramsDisclaimerText"
                Foreground="{ThemeResource MutedTextBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{markup:Localize Key=AboutDisclaimer}"
                TextWrapping="Wrap" />
        </StackPanel>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentPanel.Padding" Value="16,12,16,24" />
                        <Setter Target="FamilyPicker.(Grid.Column)" Value="0" />
                        <Setter Target="FamilyPicker.(Grid.Row)" Value="1" />
                        <Setter Target="FamilyPicker.HorizontalAlignment" Value="Stretch" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </ScrollViewer>
</local:ProgramsViewBase>
