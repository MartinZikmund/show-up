<ContentDialog
    x:Class="ShowUp.Views.BonusWorkoutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:markup="using:ShowUp.Markup"
    xmlns:models="using:ShowUp.Core.Catalog"
    Title="{markup:Localize Key=BonusDialogTitle}"
    CloseButtonText="{markup:Localize Key=Cancel}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonText="{markup:Localize Key=BonusDialogConfirm}">

    <StackPanel MinWidth="320" Spacing="16">
        <AutoSuggestBox
            x:Name="WorkoutBox"
            AutomationProperties.AutomationId="BonusWorkoutBox"
            Header="{markup:Localize Key=BonusDialogHeader}"
            MaxSuggestionListHeight="240"
            PlaceholderText="{markup:Localize Key=BonusDialogSearchPlaceholder}"
            QueryIcon="Find"
            SuggestionChosen="WorkoutBox_SuggestionChosen"
            TextChanged="WorkoutBox_TextChanged"
            TextMemberPath="Name">
            <AutoSuggestBox.ItemTemplate>
                <DataTemplate x:DataType="models:Workout">
                    <StackPanel Padding="0,4" Spacing="0">
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Name}" />
                        <TextBlock
                            Foreground="{ThemeResource MutedTextBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Family}" />
                    </StackPanel>
                </DataTemplate>
            </AutoSuggestBox.ItemTemplate>
        </AutoSuggestBox>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <NumberBox
                x:Name="DurationBox"
                AutomationProperties.AutomationId="BonusDurationBox"
                Header="{markup:Localize Key=BonusDialogDuration}"
                Maximum="600"
                Minimum="1"
                SmallChange="5"
                SpinButtonPlacementMode="Inline"
                ValidationMode="InvalidInputOverwritten"
                ValueChanged="DurationBox_ValueChanged" />
            <CalendarDatePicker
                x:Name="DatePicker"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="BonusDatePicker"
                DateChanged="DatePicker_DateChanged"
                Header="{markup:Localize Key=BonusDialogDate}" />
        </Grid>
    </StackPanel>
</ContentDialog>
