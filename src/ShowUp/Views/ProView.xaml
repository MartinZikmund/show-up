<local:ProViewBase
    x:Class="ShowUp.Views.ProView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ShowUp.Views"
    xmlns:markup="using:ShowUp.Markup"
    xmlns:vm="using:ShowUp.Core.ViewModels">

    <ScrollViewer>
        <StackPanel
            x:Name="ContentPanel"
            MaxWidth="640"
            Padding="{StaticResource PagePadding}"
            HorizontalAlignment="Left"
            Spacing="16">
            <Button
                Margin="-8,0,0,-8"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="ProBackButton"
                Command="{x:Bind ViewModel.GoBackCommand, Mode=OneWay}"
                Style="{StaticResource SubtleButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="12" Glyph="&#xE72B;" />
                    <TextBlock Text="{markup:Localize Key=Back}" />
                </StackPanel>
            </Button>

            <!--  Hero  -->
            <StackPanel Spacing="4">
                <TextBlock
                    AutomationProperties.AutomationId="ProTitle"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource SectionHeaderTextBlockStyle}"
                    Text="{markup:Localize Key=ProHeroTitle}" />
                <TextBlock
                    Foreground="{ThemeResource MutedTextBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{markup:Localize Key=ProHeroSubtitle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--  State: unavailable, pending, error or "you are Pro"  -->
            <Border
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                Visibility="{x:Bind ViewModel.StateText, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}">
                <StackPanel Spacing="8">
                    <TextBlock
                        AutomationProperties.AutomationId="ProStateText"
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.StateText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Button
                        AutomationProperties.AutomationId="ProRetryButton"
                        Command="{x:Bind ViewModel.LoadCommand}"
                        Content="{markup:Localize Key=ProRetry}"
                        Visibility="{x:Bind ViewModel.CanRetry, Mode=OneWay}" />
                    <Button
                        AutomationProperties.AutomationId="ProManageButton"
                        Command="{x:Bind ViewModel.ManageSubscriptionCommand}"
                        Content="{markup:Localize Key=ProManage}"
                        Visibility="{x:Bind ViewModel.CanManageSubscription, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!--  Free vs Pro: stacked rows so it reads the same on a phone and on a desktop  -->
            <Border
                Padding="16,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}">
                <ItemsControl AutomationProperties.AutomationId="ProFeatureList" ItemsSource="{x:Bind ViewModel.Features}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProFeatureRow">
                            <StackPanel Padding="0,8" Spacing="4">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Title}"
                                    TextWrapping="Wrap" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock
                                            Foreground="{ThemeResource MutedTextBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{markup:Localize Key=ProColumnFree}" />
                                        <TextBlock
                                            Foreground="{ThemeResource MutedTextBrush}"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind Free}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock
                                            Foreground="{ThemeResource MutedTextBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{markup:Localize Key=ProColumnPro}" />
                                        <TextBlock
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind Pro}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!--  Offers  -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.CanBuy, Mode=OneWay}">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=ProOffersHeader}" />
                <ItemsControl
                    AutomationProperties.AutomationId="ProOffers"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                    ItemsSource="{x:Bind ViewModel.OfferRows, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProOfferRow">
                            <Button
                                Margin="0,0,0,8"
                                Padding="16,12"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.AutomationId="{x:Bind Offer.Id}"
                                AutomationProperties.Name="{x:Bind AutomationName}"
                                Click="OnOfferClick"
                                Tag="{x:Bind Offer}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Offer.Title}" />
                                        <TextBlock
                                            Foreground="{ThemeResource MutedTextBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Note}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Offer.Price}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    AutomationProperties.AutomationId="ProSubscriptionDisclosure"
                    Foreground="{ThemeResource MutedTextBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.SubscriptionDisclosure}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.ShowSubscriptionDisclosure, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    AutomationProperties.AutomationId="ProRestoreButton"
                    Command="{x:Bind ViewModel.RestoreCommand, Mode=OneWay}"
                    Content="{markup:Localize Key=ProRestore}" />
                <ProgressRing
                    Width="20"
                    Height="20"
                    AutomationProperties.Name="{markup:Localize Key=ProBusyName}"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </StackPanel>

            <!--  Store review wants both links where the purchase happens  -->
            <StackPanel Orientation="Horizontal" Spacing="16">
                <HyperlinkButton
                    Margin="-12,0,0,0"
                    AutomationProperties.AutomationId="ProTermsLink"
                    Command="{x:Bind ViewModel.OpenTermsCommand}"
                    Content="{markup:Localize Key=ProTerms}" />
                <HyperlinkButton
                    AutomationProperties.AutomationId="ProPrivacyLink"
                    Command="{x:Bind ViewModel.OpenPrivacyCommand}"
                    Content="{markup:Localize Key=ProPrivacy}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</local:ProViewBase>
