<local:ProViewBase
    x:Class="ShowUp.Views.ProView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ent="using:ShowUp.Core.Entitlements"
    xmlns:local="using:ShowUp.Views"
    xmlns:markup="using:ShowUp.Markup"
    xmlns:vm="using:ShowUp.Core.ViewModels">

    <ScrollViewer>
        <StackPanel
            x:Name="ContentPanel"
            MaxWidth="640"
            Padding="{StaticResource PagePadding}"
            HorizontalAlignment="Left"
            Spacing="16">
            <Button
                Margin="-8,0,0,-8"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="ProBackButton"
                Command="{x:Bind ViewModel.GoBackCommand, Mode=OneWay}"
                Style="{StaticResource SubtleButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="12" Glyph="&#xE72B;" />
                    <TextBlock Text="{markup:Localize Key=Back}" />
                </StackPanel>
            </Button>

            <!--  Hero  -->
            <StackPanel Spacing="4">
                <TextBlock
                    AutomationProperties.AutomationId="ProTitle"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource SectionHeaderTextBlockStyle}"
                    Text="{markup:Localize Key=ProHeroTitle}" />
                <TextBlock
                    Foreground="{ThemeResource MutedTextBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{markup:Localize Key=ProHeroSubtitle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--  State: unavailable, pending, error or "you are Pro"  -->
            <Border
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                Visibility="{x:Bind ViewModel.StateText, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}">
                <TextBlock
                    AutomationProperties.AutomationId="ProStateText"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind ViewModel.StateText, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Border>

            <!--  Free vs Pro  -->
            <Border
                Padding="16,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}">
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Foreground="{ThemeResource MutedTextBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=ProFeaturesHeader}" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{markup:Localize Key=ProColumnFree}" />
                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{markup:Localize Key=ProColumnPro}" />
                    </Grid>
                    <ItemsControl AutomationProperties.AutomationId="ProFeatureList" ItemsSource="{x:Bind ViewModel.Features}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProFeatureRow">
                                <Grid Padding="0,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind Title}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Foreground="{ThemeResource MutedTextBrush}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind Free}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Pro}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!--  Offers  -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.CanBuy, Mode=OneWay}">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=ProOffersHeader}" />
                <ItemsControl
                    AutomationProperties.AutomationId="ProOffers"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                    ItemsSource="{x:Bind ViewModel.Offers, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="ent:ProOffer">
                            <Button
                                Margin="0,0,0,8"
                                Padding="16,12"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.AutomationId="{x:Bind Id}"
                                Click="OnOfferClick"
                                Tag="{x:Bind}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Title}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Price}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    AutomationProperties.AutomationId="ProRestoreButton"
                    Command="{x:Bind ViewModel.RestoreCommand, Mode=OneWay}"
                    Content="{markup:Localize Key=ProRestore}" />
                <ProgressRing
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</local:ProViewBase>
