<local:SettingsViewBase
    x:Class="ShowUp.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ShowUp.Controls"
    xmlns:local="using:ShowUp.Views"
    xmlns:marking="using:ShowUp.Core.Marking"
    xmlns:markup="using:ShowUp.Markup"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:tracking="using:ShowUp.Core.Tracking"
    xmlns:vm="using:ShowUp.Core.ViewModels">


    <ScrollViewer>
        <StackPanel
            x:Name="ContentRoot"
            Padding="{StaticResource PagePadding}"
            Orientation="Vertical"
            Spacing="8">

            <!--  Page header  -->
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource SectionHeaderTextBlockStyle}"
                Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" />

            <!--  Pro  -->
            <toolkit:SettingsCard
                AutomationProperties.AutomationId="ProSettingsCard"
                Command="{x:Bind ViewModel.OpenProCommand}"
                Description="{x:Bind ViewModel.ProStatusText, Mode=OneWay}"
                Header="{markup:Localize Key=ProCardTitle}"
                IsClickEnabled="True">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE734;" />
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>

            <!--  Account (hidden when this build has no account server)  -->
            <StackPanel
                x:Name="AccountSection"
                Spacing="8"
                Visibility="{x:Bind ViewModel.Account.IsAvailable, Mode=OneWay}">
                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{markup:Localize Key=AccountHeader}" />

                <toolkit:SettingsCard
                    HorizontalContentAlignment="Left"
                    AutomationProperties.AutomationId="AccountSignedOutCard"
                    ContentAlignment="Vertical"
                    Description="{markup:Localize Key=AccountSignedOutDescription}"
                    Header="{markup:Localize Key=AccountSignInHeader}"
                    Visibility="{x:Bind ViewModel.Account.IsSignedOut, Mode=OneWay}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE77B;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel
                        MaxWidth="400"
                        HorizontalAlignment="Left"
                        Spacing="12">
                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Account.IsEnteringEmail, Mode=OneWay}">
                            <TextBox
                                MinWidth="280"
                                AutomationProperties.AutomationId="AccountEmailBox"
                                Header="{markup:Localize Key=AccountEmailLabel}"
                                InputScope="EmailSmtpAddress"
                                IsEnabled="{x:Bind ViewModel.Account.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                KeyDown="EmailBox_KeyDown"
                                PlaceholderText="{markup:Localize Key=AccountEmailPlaceholder}"
                                Text="{x:Bind ViewModel.Account.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                AutomationProperties.AutomationId="AccountSendCodeButton"
                                Command="{x:Bind ViewModel.Account.SendCodeCommand}"
                                Content="{markup:Localize Key=AccountSendCode}"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>

                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Account.IsEnteringCode, Mode=OneWay}">
                            <TextBlock
                                AutomationProperties.AutomationId="AccountCodeSentText"
                                Text="{x:Bind ViewModel.Account.CodeSentText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBox
                                Width="200"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="AccountCodeBox"
                                Header="{markup:Localize Key=AccountCodeLabel}"
                                InputScope="Number"
                                IsEnabled="{x:Bind ViewModel.Account.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                KeyDown="CodeBox_KeyDown"
                                PlaceholderText="{markup:Localize Key=AccountCodePlaceholder}"
                                Text="{x:Bind ViewModel.Account.Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    AutomationProperties.AutomationId="AccountVerifyButton"
                                    Command="{x:Bind ViewModel.Account.VerifyCommand}"
                                    Content="{markup:Localize Key=AccountVerify}"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <HyperlinkButton
                                    AutomationProperties.AutomationId="AccountResendCodeButton"
                                    Command="{x:Bind ViewModel.Account.SendCodeCommand}"
                                    Content="{markup:Localize Key=AccountResendCode}" />
                            </StackPanel>
                            <HyperlinkButton
                                Padding="0"
                                AutomationProperties.AutomationId="AccountChangeEmailButton"
                                Command="{x:Bind ViewModel.Account.ChangeEmailCommand}"
                                Content="{markup:Localize Key=AccountChangeEmail}" />
                        </StackPanel>

                        <ProgressBar
                            AutomationProperties.AutomationId="AccountBusyIndicator"
                            IsIndeterminate="True"
                            Visibility="{x:Bind ViewModel.Account.IsBusy, Mode=OneWay}" />
                        <TextBlock
                            x:Name="AccountErrorText"
                            AutomationProperties.AutomationId="AccountErrorText"
                            AutomationProperties.LiveSetting="Assertive"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Text="{x:Bind ViewModel.Account.ErrorText, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.Account.HasError, Mode=OneWay}" />
                    </StackPanel>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard
                    AutomationProperties.AutomationId="AccountSignedInCard"
                    Description="{markup:Localize Key=AccountSignedInDescription}"
                    Header="{x:Bind ViewModel.Account.SignedInEmail, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.Account.IsSignedIn, Mode=OneWay}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE77B;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <Button
                        AutomationProperties.AutomationId="AccountSignOutButton"
                        Command="{x:Bind ViewModel.Account.SignOutCommand}"
                        Content="{markup:Localize Key=AccountSignOut}" />
                </toolkit:SettingsCard>

                <toolkit:SettingsCard
                    AutomationProperties.AutomationId="AccountSyncCard"
                    Description="{markup:Localize Key=AccountSyncComingSoon}"
                    Header="{markup:Localize Key=AccountSyncHeader}"
                    Visibility="{x:Bind ViewModel.Account.IsSignedIn, Mode=OneWay}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE895;" />
                    </toolkit:SettingsCard.HeaderIcon>
                </toolkit:SettingsCard>
            </StackPanel>

            <!--  General section  -->
            <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{markup:Localize Key=General}" />

            <toolkit:SettingsCard Header="{markup:Localize Key=Theme}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE793;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    AutomationProperties.AutomationId="ThemeComboBox"
                    ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                    SelectedItem="{x:Bind ViewModel.Theme, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="ElementTheme">
                            <TextBlock Text="{x:Bind Converter={StaticResource EnumLocalizationConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                AutomationProperties.AutomationId="RemindersSettingsCard"
                Command="{x:Bind ViewModel.OpenRemindersCommand}"
                Description="{markup:Localize Key=RemindersCardDescription}"
                Header="{markup:Localize Key=Reminders}"
                IsClickEnabled="True">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEA8F;" />
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>

            <!--  Crossing off section  -->
            <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{markup:Localize Key=CrossingOff}" />

            <toolkit:SettingsCard Description="{markup:Localize Key=MarkerSoundDescription}" Header="{markup:Localize Key=MarkerSound}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE767;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    AutomationProperties.AutomationId="MarkerSoundToggle"
                    AutomationProperties.Name="{markup:Localize Key=MarkerSound}"
                    IsOn="{x:Bind ViewModel.MarkerSoundEnabled, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Description="{markup:Localize Key=MarkerHapticsDescription}" Header="{markup:Localize Key=MarkerHaptics}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8EA;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    AutomationProperties.AutomationId="MarkerHapticsToggle"
                    AutomationProperties.Name="{markup:Localize Key=MarkerHaptics}"
                    IsOn="{x:Bind ViewModel.MarkerHapticsEnabled, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Description="{markup:Localize Key=CrossOffStyleDescription}" Header="{markup:Localize Key=CrossOffStyle}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEDC6;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    AutomationProperties.AutomationId="CrossOffStyleComboBox"
                    AutomationProperties.Name="{markup:Localize Key=CrossOffStyle}"
                    ItemsSource="{x:Bind ViewModel.CrossOffStyleOptions}"
                    SelectedItem="{x:Bind ViewModel.CrossOffStyle, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="marking:CrossOffStyle">
                            <TextBlock Text="{x:Bind Converter={StaticResource EnumLocalizationConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                x:Name="MarkerColorCard"
                ContentAlignment="Vertical"
                Description="{markup:Localize Key=MarkerColorDescription}"
                Header="{markup:Localize Key=MarkerColor}">
                <StackPanel Spacing="4">
                    <controls:MarkerSwatchPicker
                        x:Name="MarkerColorPicker"
                        AutomationProperties.AutomationId="MarkerColorPicker"
                        AutomationProperties.Name="{markup:Localize Key=MarkerColor}"
                        IsEnabled="{x:Bind ViewModel.CanChangeMarkerColor, Mode=OneWay}"
                        IsItemClickEnabled="False"
                        ItemContainerStyle="{StaticResource MarkerSwatchItemStyle}"
                        ItemsSource="{x:Bind ViewModel.MarkerSwatches}"
                        SelectedItem="{x:Bind ViewModel.SelectedMarkerSwatch, Mode=TwoWay}"
                        SelectionMode="Single">
                        <controls:MarkerSwatchPicker.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </controls:MarkerSwatchPicker.ItemsPanel>
                        <controls:MarkerSwatchPicker.ItemTemplate>
                            <DataTemplate x:DataType="vm:MarkerSwatch">
                                <Grid
                                    Width="38"
                                    Height="38"
                                    ToolTipService.ToolTip="{x:Bind Name}">
                                    <Ellipse
                                        Margin="1"
                                        Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                        StrokeThickness="2"
                                        Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                                    <controls:MarkerSwatchDot Color="{x:Bind Color}" />
                                </Grid>
                            </DataTemplate>
                        </controls:MarkerSwatchPicker.ItemTemplate>
                    </controls:MarkerSwatchPicker>
                    <controls:ProGateHint Command="{x:Bind ViewModel.OpenProCommand}" Visibility="{x:Bind ViewModel.IsMarkerColorLocked, Mode=OneWay}" />
                </StackPanel>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Description="{markup:Localize Key=CrossMomentDescription}" Header="{markup:Localize Key=CrossMoment}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE73E;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    AutomationProperties.AutomationId="CrossMomentModeComboBox"
                    AutomationProperties.Name="{markup:Localize Key=CrossMoment}"
                    ItemsSource="{x:Bind ViewModel.CrossMomentModeOptions}"
                    SelectedItem="{x:Bind ViewModel.CrossMomentMode, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="marking:CrossMomentMode">
                            <TextBlock Text="{x:Bind Converter={StaticResource EnumLocalizationConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Description="{markup:Localize Key=UnitsDescription}" Header="{markup:Localize Key=Units}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xECC6;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    AutomationProperties.AutomationId="UnitSystemComboBox"
                    AutomationProperties.Name="{markup:Localize Key=Units}"
                    ItemsSource="{x:Bind ViewModel.UnitSystemOptions}"
                    SelectedItem="{x:Bind ViewModel.UnitSystem, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="tracking:UnitSystem">
                            <TextBlock Text="{x:Bind Converter={StaticResource EnumLocalizationConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </toolkit:SettingsCard>

            <!--  About section  -->
            <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{markup:Localize Key=About}" />

            <toolkit:SettingsCard Description="{markup:Localize Key=AboutAppDescription}" Header="{markup:Localize Key=ApplicationName}">
                <toolkit:SettingsCard.HeaderIcon>
                    <BitmapIcon ShowAsMonochrome="False" UriSource="ms-appx:///Assets/Icons/icon_foreground.png" />
                </toolkit:SettingsCard.HeaderIcon>
                <StackPanel HorizontalAlignment="Right" Spacing="2">
                    <TextBlock HorizontalAlignment="Right" Text="{x:Bind ViewModel.AppVersion}" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.WorktreeLabel}"
                        Visibility="{x:Bind ViewModel.WorktreeLabel, Converter={StaticResource StringVisibilityConverter}}" />
                </StackPanel>
            </toolkit:SettingsCard>

            <TextBlock
                Margin="1,8,0,0"
                AutomationProperties.AutomationId="AboutDisclaimerText"
                Foreground="{ThemeResource MutedTextBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{markup:Localize Key=AboutDisclaimer}"
                TextWrapping="Wrap" />

            <!--  Debug section  -->
            <StackPanel x:Name="DebugPanel" Visibility="{x:Bind ViewModel.IsDebug}">
                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{markup:Localize Key=Debugging}" />

                <toolkit:SettingsCard Header="{markup:Localize Key=ClearPreferences}">
                    <Button Command="{x:Bind ViewModel.ClearPreferencesCommand}" Content="{markup:Localize Key=Clear}" />
                </toolkit:SettingsCard>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</local:SettingsViewBase>
