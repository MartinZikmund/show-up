<local:SettingsViewBase
    x:Class="ShowUp.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ShowUp.Controls"
    xmlns:local="using:ShowUp.Views"
    xmlns:marking="using:ShowUp.Core.Marking"
    xmlns:markup="using:ShowUp.Markup"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:ShowUp.Core.ViewModels">

    <local:SettingsViewBase.Resources>
        <!--  The selection ring is drawn by the swatch itself, so the container stays plain  -->
        <Style x:Key="MarkerSwatchItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:SettingsViewBase.Resources>

    <ScrollViewer>
        <StackPanel
            x:Name="ContentRoot"
            Padding="{StaticResource PagePadding}"
            Orientation="Vertical"
            Spacing="8">

            <!--  Page header  -->
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource SectionHeaderTextBlockStyle}"
                Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" />

            <!--  General section  -->
            <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{markup:Localize Key=General}" />

            <toolkit:SettingsCard Header="{markup:Localize Key=Theme}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE793;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    AutomationProperties.AutomationId="ThemeComboBox"
                    ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                    SelectedItem="{x:Bind ViewModel.Theme, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="ElementTheme">
                            <TextBlock Text="{x:Bind Converter={StaticResource EnumLocalizationConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </toolkit:SettingsCard>

            <!--  Crossing off section  -->
            <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{markup:Localize Key=CrossingOff}" />

            <toolkit:SettingsCard Description="{markup:Localize Key=MarkerSoundDescription}" Header="{markup:Localize Key=MarkerSound}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE767;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    AutomationProperties.AutomationId="MarkerSoundToggle"
                    AutomationProperties.Name="{markup:Localize Key=MarkerSound}"
                    IsOn="{x:Bind ViewModel.MarkerSoundEnabled, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Description="{markup:Localize Key=MarkerHapticsDescription}" Header="{markup:Localize Key=MarkerHaptics}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8EA;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    AutomationProperties.AutomationId="MarkerHapticsToggle"
                    AutomationProperties.Name="{markup:Localize Key=MarkerHaptics}"
                    IsOn="{x:Bind ViewModel.MarkerHapticsEnabled, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Description="{markup:Localize Key=CrossOffStyleDescription}" Header="{markup:Localize Key=CrossOffStyle}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEDC6;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    AutomationProperties.AutomationId="CrossOffStyleComboBox"
                    AutomationProperties.Name="{markup:Localize Key=CrossOffStyle}"
                    ItemsSource="{x:Bind ViewModel.CrossOffStyleOptions}"
                    SelectedItem="{x:Bind ViewModel.CrossOffStyle, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="marking:CrossOffStyle">
                            <TextBlock Text="{x:Bind Converter={StaticResource EnumLocalizationConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                Description="{markup:Localize Key=MarkerColorDescription}"
                Header="{markup:Localize Key=MarkerColor}"
                IsEnabled="{x:Bind ViewModel.CanChangeMarkerColor, Mode=OneWay}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ListView
                    AutomationProperties.AutomationId="MarkerColorPicker"
                    AutomationProperties.Name="{markup:Localize Key=MarkerColor}"
                    IsItemClickEnabled="False"
                    ItemContainerStyle="{StaticResource MarkerSwatchItemStyle}"
                    ItemsSource="{x:Bind ViewModel.MarkerSwatches}"
                    SelectedItem="{x:Bind ViewModel.SelectedMarkerSwatch, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:MarkerSwatch">
                            <Grid
                                Width="36"
                                Height="36"
                                AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                AutomationProperties.Name="{x:Bind Name}"
                                ToolTipService.ToolTip="{x:Bind Name}">
                                <Ellipse
                                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                    StrokeThickness="2"
                                    Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                                <controls:MarkerSwatchDot
                                    Width="32"
                                    Height="32"
                                    Color="{x:Bind Color}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Description="{markup:Localize Key=CrossMomentDescription}" Header="{markup:Localize Key=CrossMoment}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE73E;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    AutomationProperties.AutomationId="CrossMomentModeComboBox"
                    AutomationProperties.Name="{markup:Localize Key=CrossMoment}"
                    ItemsSource="{x:Bind ViewModel.CrossMomentModeOptions}"
                    SelectedItem="{x:Bind ViewModel.CrossMomentMode, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="marking:CrossMomentMode">
                            <TextBlock Text="{x:Bind Converter={StaticResource EnumLocalizationConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </toolkit:SettingsCard>

            <!--  About section  -->
            <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{markup:Localize Key=About}" />

            <toolkit:SettingsCard Description="{markup:Localize Key=AboutAppDescription}" Header="{markup:Localize Key=ApplicationName}">
                <toolkit:SettingsCard.HeaderIcon>
                    <BitmapIcon ShowAsMonochrome="False" UriSource="ms-appx:///Assets/Icons/icon_foreground.png" />
                </toolkit:SettingsCard.HeaderIcon>
                <StackPanel HorizontalAlignment="Right" Spacing="2">
                    <TextBlock HorizontalAlignment="Right" Text="{x:Bind ViewModel.AppVersion}" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.WorktreeLabel}"
                        Visibility="{x:Bind ViewModel.WorktreeLabel, Converter={StaticResource StringVisibilityConverter}}" />
                </StackPanel>
            </toolkit:SettingsCard>

            <TextBlock
                Margin="1,8,0,0"
                AutomationProperties.AutomationId="AboutDisclaimerText"
                Foreground="{ThemeResource MutedTextBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{markup:Localize Key=AboutDisclaimer}"
                TextWrapping="Wrap" />

            <!--  Debug section  -->
            <StackPanel Visibility="{x:Bind ViewModel.IsDebug}">
                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{markup:Localize Key=Debugging}" />

                <toolkit:SettingsCard Header="{markup:Localize Key=ClearPreferences}">
                    <Button Command="{x:Bind ViewModel.ClearPreferencesCommand}" Content="{markup:Localize Key=Clear}" />
                </toolkit:SettingsCard>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</local:SettingsViewBase>
