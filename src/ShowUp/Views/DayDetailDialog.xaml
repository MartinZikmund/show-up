<ContentDialog
    x:Class="ShowUp.Views.DayDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ShowUp.Controls"
    xmlns:local="using:ShowUp.Views"
    xmlns:markup="using:ShowUp.Markup"
    xmlns:vm="using:ShowUp.Core.ViewModels"
    Title="{x:Bind ViewModel.Title, Mode=OneWay}"
    AutomationProperties.AutomationId="DayDetailDialog"
    CloseButtonText="{markup:Localize Key=Cancel}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
    PrimaryButtonText="{markup:Localize Key=Save}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            x:Name="ContentPanel"
            Padding="0,0,12,0"
            Spacing="16">
            <TextBlock
                AutomationProperties.AutomationId="DayDetailDate"
                Foreground="{ThemeResource MutedTextBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.DateLabel, Mode=OneWay}" />
            <TextBlock
                AutomationProperties.AutomationId="DayDetailReadOnly"
                Foreground="{ThemeResource MutedTextBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{markup:Localize Key=ProgramReadOnlyMessage}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.IsReadOnly, Mode=OneWay}" />

            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Sessions, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="12" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:DaySessionViewModel">
                        <StackPanel
                            Padding="12"
                            Background="{ThemeResource CalendarCellBackgroundBrush}"
                            BorderBrush="{ThemeResource CalendarCellBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="40"
                                    Height="40"
                                    VerticalAlignment="Center"
                                    BorderBrush="{ThemeResource CalendarCellBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <controls:MarkerCrossControl
                                        Margin="4"
                                        AnimateChanges="False"
                                        AutomationProperties.AccessibilityView="Raw"
                                        Strokes="{x:Bind local:DayDetailDialog.StrokesFor(ShowsCrossed), Mode=OneWay}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Name}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource MutedTextBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind local:DayDetailDialog.StatusText(IsDone, PendingUncross), Mode=OneWay}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="{x:Bind UncrossAutomationId}"
                                    Click="ToggleUncross_Click"
                                    Content="{markup:Localize Key=CalendarUncross}"
                                    Tag="{x:Bind}"
                                    Visibility="{x:Bind CanUncross, Mode=OneWay}" />
                                <Button
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="{x:Bind UndoAutomationId}"
                                    Click="ToggleUncross_Click"
                                    Content="{markup:Localize Key=DayDetailUndo}"
                                    Tag="{x:Bind}"
                                    Visibility="{x:Bind PendingUncross, Mode=OneWay}" />
                            </Grid>
                            <controls:MetricInputsControl Inputs="{x:Bind Inputs}" Visibility="{x:Bind HasResults}" />
                            <TextBox
                                AcceptsReturn="True"
                                AutomationProperties.AutomationId="{x:Bind NoteAutomationId}"
                                AutomationProperties.Name="{markup:Localize Key=DayDetailNotePlaceholder}"
                                IsReadOnly="{x:Bind IsLocked}"
                                MaxLength="4000"
                                PlaceholderText="{markup:Localize Key=DayDetailNotePlaceholder}"
                                Text="{x:Bind Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasBonuses, Mode=OneWay}">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{markup:Localize Key=DayDetailBonusHeader}" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Bonuses, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:DayBonusViewModel">
                            <StackPanel
                                Padding="12"
                                BorderBrush="{ThemeResource CalendarCellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                Spacing="12">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Title}"
                                    TextWrapping="Wrap" />
                                <controls:MetricInputsControl Inputs="{x:Bind Inputs}" Visibility="{x:Bind HasResults}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <TextBox
                MinHeight="72"
                AcceptsReturn="True"
                AutomationProperties.AutomationId="DayDetailDayNote"
                Header="{markup:Localize Key=DayDetailDayNote}"
                IsReadOnly="{x:Bind ViewModel.IsReadOnly, Mode=OneWay}"
                MaxLength="4000"
                PlaceholderText="{markup:Localize Key=DayDetailNotePlaceholder}"
                Text="{x:Bind ViewModel.DayNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
