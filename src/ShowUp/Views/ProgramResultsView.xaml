<local:ProgramResultsViewBase
    x:Class="ShowUp.Views.ProgramResultsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ShowUp.Views"
    xmlns:markup="using:ShowUp.Markup"
    xmlns:vm="using:ShowUp.Core.ViewModels">

    <local:ProgramResultsViewBase.Resources>
        <x:Double x:Key="ResultsNameColumnWidth">136</x:Double>
        <x:Double x:Key="ResultsCellWidth">88</x:Double>
        <x:Double x:Key="ResultsHeaderHeight">48</x:Double>
        <x:Double x:Key="ResultsRowHeight">52</x:Double>
    </local:ProgramResultsViewBase.Resources>

    <ScrollViewer>
        <StackPanel
            x:Name="ContentPanel"
            MaxWidth="1040"
            Padding="{StaticResource PagePadding}"
            HorizontalAlignment="Left"
            Spacing="16">
            <Button
                Margin="-8,0,0,-8"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="ResultsBackButton"
                Command="{x:Bind ViewModel.GoBackCommand, Mode=OneWay}"
                Style="{StaticResource SubtleButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="12" Glyph="&#xE72B;" />
                    <TextBlock Text="{markup:Localize Key=Back}" />
                </StackPanel>
            </Button>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock
                        AutomationProperties.AutomationId="ResultsTitle"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource SectionHeaderTextBlockStyle}"
                        Text="{markup:Localize Key=ResultsTitle}" />
                    <TextBlock
                        AutomationProperties.AutomationId="ResultsProgramName"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.ProgramName, Mode=OneWay}" />
                    <TextBlock
                        Foreground="{ThemeResource MutedTextBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{markup:Localize Key=ResultsHint}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    AutomationProperties.AutomationId="ResultsProgramNotesButton"
                    AutomationProperties.Name="{markup:Localize Key=CalendarProgramNotes}"
                    Command="{x:Bind ViewModel.EditProgramNoteCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="{markup:Localize Key=CalendarProgramNotes}"
                    Visibility="{x:Bind ViewModel.HasEnrollment, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE70B;" />
                        <TextBlock x:Name="NotesButtonText" Text="{markup:Localize Key=CalendarProgramNotes}" />
                    </StackPanel>
                </Button>
            </Grid>

            <StackPanel
                Padding="0,24"
                Spacing="8"
                Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}">
                <TextBlock
                    AutomationProperties.AutomationId="ResultsEmptyTitle"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{markup:Localize Key=ResultsEmptyTitle}" />
                <TextBlock
                    Foreground="{ThemeResource MutedTextBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind local:ProgramResultsView.EmptyMessage(ViewModel.HasEnrollment), Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tables, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="32" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:ResultsTableViewModel">
                        <StackPanel AutomationProperties.AutomationId="{x:Bind AutomationId}" Spacing="8">
                            <TextBlock
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind Title}" />
                            <Grid
                                HorizontalAlignment="Left"
                                Background="{ThemeResource CalendarCellBackgroundBrush}"
                                BorderBrush="{ThemeResource CalendarCellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  Pinned metric names; rows share fixed heights with the scrolling cells  -->
                                <StackPanel
                                    Width="{StaticResource ResultsNameColumnWidth}"
                                    BorderBrush="{ThemeResource CalendarCellBorderBrush}"
                                    BorderThickness="0,0,1,0">
                                    <Border Height="{StaticResource ResultsHeaderHeight}" />
                                    <ItemsRepeater ItemsSource="{x:Bind Rows}">
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ResultsRowViewModel">
                                                <StackPanel
                                                    Height="{StaticResource ResultsRowHeight}"
                                                    Padding="12,0"
                                                    VerticalAlignment="Center"
                                                    BorderBrush="{ThemeResource CalendarCellBorderBrush}"
                                                    BorderThickness="0,1,0,0">
                                                    <TextBlock
                                                        Margin="0,6,0,0"
                                                        MaxLines="2"
                                                        Style="{StaticResource BodyTextBlockStyle}"
                                                        Text="{x:Bind MetricName}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="Wrap"
                                                        ToolTipService.ToolTip="{x:Bind MetricName}" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource MutedTextBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind UnitHint}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>

                                <ScrollViewer
                                    Grid.Column="1"
                                    HorizontalScrollBarVisibility="Auto"
                                    HorizontalScrollMode="Enabled"
                                    VerticalScrollBarVisibility="Disabled"
                                    VerticalScrollMode="Disabled">
                                    <StackPanel>
                                        <ItemsRepeater Height="{StaticResource ResultsHeaderHeight}" ItemsSource="{x:Bind Columns}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Orientation="Horizontal" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ResultsColumnHeader">
                                                    <StackPanel
                                                        Width="{StaticResource ResultsCellWidth}"
                                                        Padding="8,4"
                                                        VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Label}" />
                                                        <TextBlock
                                                            Foreground="{ThemeResource MutedTextBrush}"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind DateLabel}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                        <ItemsRepeater ItemsSource="{x:Bind Rows}">
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ResultsRowViewModel">
                                                    <ItemsRepeater ItemsSource="{x:Bind Cells}">
                                                        <ItemsRepeater.Layout>
                                                            <StackLayout Orientation="Horizontal" />
                                                        </ItemsRepeater.Layout>
                                                        <ItemsRepeater.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:ResultsCellViewModel">
                                                                <StackPanel
                                                                    Width="{StaticResource ResultsCellWidth}"
                                                                    Height="{StaticResource ResultsRowHeight}"
                                                                    Padding="8,6"
                                                                    BorderBrush="{ThemeResource CalendarCellBorderBrush}"
                                                                    BorderThickness="0,1,0,0">
                                                                    <!--  The value carries the whole cell for screen readers: metric, column, value and change  -->
                                                                    <TextBlock
                                                                        AutomationProperties.AccessibilityView="Content"
                                                                        AutomationProperties.Name="{x:Bind AutomationName}"
                                                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                        Text="{x:Bind local:ProgramResultsView.ValueOrDash(ValueText)}" />
                                                                    <StackPanel
                                                                        Orientation="Horizontal"
                                                                        Spacing="2"
                                                                        Visibility="{x:Bind IsBetter}">
                                                                        <FontIcon
                                                                            AutomationProperties.AccessibilityView="Raw"
                                                                            FontSize="10"
                                                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                                            Glyph="{x:Bind ArrowGlyph}" />
                                                                        <TextBlock
                                                                            AutomationProperties.AccessibilityView="Raw"
                                                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                                            Text="{x:Bind DeltaText}" />
                                                                    </StackPanel>
                                                                    <StackPanel
                                                                        Orientation="Horizontal"
                                                                        Spacing="2"
                                                                        Visibility="{x:Bind IsWorse}">
                                                                        <FontIcon
                                                                            AutomationProperties.AccessibilityView="Raw"
                                                                            FontSize="10"
                                                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                            Glyph="{x:Bind ArrowGlyph}" />
                                                                        <TextBlock
                                                                            AutomationProperties.AccessibilityView="Raw"
                                                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                                            Text="{x:Bind DeltaText}" />
                                                                    </StackPanel>
                                                                    <StackPanel
                                                                        Orientation="Horizontal"
                                                                        Spacing="2"
                                                                        Visibility="{x:Bind IsSame}">
                                                                        <FontIcon
                                                                            AutomationProperties.AccessibilityView="Raw"
                                                                            FontSize="10"
                                                                            Foreground="{ThemeResource MutedTextBrush}"
                                                                            Glyph="{x:Bind ArrowGlyph}" />
                                                                        <TextBlock
                                                                            AutomationProperties.AccessibilityView="Raw"
                                                                            Foreground="{ThemeResource MutedTextBrush}"
                                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                                            Text="{x:Bind DeltaText}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsRepeater.ItemTemplate>
                                                    </ItemsRepeater>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasPending, Mode=OneWay}">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{markup:Localize Key=ResultsPendingHeader}" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Pending, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:PendingResultsViewModel">
                            <StackPanel
                                Padding="12,8"
                                AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                Background="{ThemeResource CalendarCellBackgroundBrush}"
                                BorderBrush="{ThemeResource CalendarCellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                <TextBlock
                                    Foreground="{ThemeResource MutedTextBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Detail}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </StackPanel>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentPanel.Padding" Value="16,12,16,24" />
                        <Setter Target="NotesButtonText.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </ScrollViewer>
</local:ProgramResultsViewBase>
