<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ShowUp.Controls">

    <Thickness x:Key="PagePadding">24,16,24,24</Thickness>

    <!--  Barlow Condensed (OFL, bundled in Assets/Fonts) for day numbers and headers  -->
    <FontFamily x:Key="DisplayFontFamily">ms-appx:///Assets/Fonts/BarlowCondensed-SemiBold.ttf#Barlow Condensed SemiBold</FontFamily>

    <Style x:Key="DisplayNumberTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="24" />
    </Style>

    <Style
        x:Key="DisplayNumberLargeTextBlockStyle"
        BasedOn="{StaticResource DisplayNumberTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="44" />
    </Style>

    <!--  Cross moment caption: "Day 10 of 60 · (flame) 9-day streak"  -->
    <Style x:Key="CrossMomentCaptionTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="CharacterSpacing" Value="30" />
    </Style>

    <Style x:Key="SectionHeaderTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="CharacterSpacing" Value="20" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <!--  Settings section header style  -->
    <Style
        x:Key="SettingsSectionHeaderTextBlockStyle"
        BasedOn="{StaticResource BodyStrongTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Margin" Value="1,30,0,6" />
    </Style>

    <!--  SubtleButtonStyle: transparent background with subtle hover/press feedback  -->
    <Style x:Key="SubtleButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="RootGrid"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ContentPresenter"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.8"
                                            Duration="0:0:0.05" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ContentPresenter"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.5"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  CardButtonStyle: transparent button that scales on hover/press  -->
    <Style x:Key="CardButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="RootGrid"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter.RenderTransform>
                                <ScaleTransform x:Name="ScaleTransform" />
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ContentPresenter"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.9"
                                            Duration="0:0:0.1" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="ScaleTransform"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1.03"
                                            Duration="0:0:0.2" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="ScaleTransform"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1.03"
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ContentPresenter"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.8"
                                            Duration="0:0:0.05" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="ScaleTransform"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="0.98"
                                            Duration="0:0:0.05" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="ScaleTransform"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="0.98"
                                            Duration="0:0:0.05" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ContentPresenter"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.5"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Hand-drawn marker X; geometry and animation live in code (MarkerCrossControl.cs)  -->
    <Style TargetType="controls:MarkerCrossControl">
        <Setter Property="MarkerBrush" Value="{ThemeResource MarkerBrush}" />
        <Setter Property="BleedBrush" Value="{ThemeResource MarkerBleedBrush}" />
        <Setter Property="BleedOpacity" Value="{ThemeResource MarkerBleedOpacity}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:MarkerCrossControl">
                    <Grid>
                        <!--  Bleed under both strokes first, then the ink, then the faint texture streaks  -->
                        <Path
                            x:Name="PART_FirstUnder"
                            Opacity="{TemplateBinding BleedOpacity}"
                            Stroke="{TemplateBinding BleedBrush}"
                            StrokeDashCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round" />
                        <Path
                            x:Name="PART_SecondUnder"
                            Opacity="{TemplateBinding BleedOpacity}"
                            Stroke="{TemplateBinding BleedBrush}"
                            StrokeDashCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round" />
                        <Path
                            x:Name="PART_First"
                            Opacity="0.9"
                            Stroke="{TemplateBinding MarkerBrush}"
                            StrokeDashCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round" />
                        <Path
                            x:Name="PART_Second"
                            Opacity="0.9"
                            Stroke="{TemplateBinding MarkerBrush}"
                            StrokeDashCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round" />
                        <Path
                            x:Name="PART_FirstTexture"
                            Opacity="0.5"
                            Stroke="{TemplateBinding MarkerBrush}"
                            StrokeDashCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round" />
                        <Path
                            x:Name="PART_SecondTexture"
                            Opacity="0.5"
                            Stroke="{TemplateBinding MarkerBrush}"
                            StrokeDashCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round" />
                        <!--  The user's own drawn crosses (Inks)  -->
                        <controls:InkView
                            x:Name="PART_Ink"
                            BleedBrush="{TemplateBinding BleedBrush}"
                            BleedOpacity="{TemplateBinding BleedOpacity}"
                            MarkerBrush="{TemplateBinding MarkerBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Calendar phase header ("Month 1"), between program weeks  -->
    <Style
        x:Key="CalendarPhaseHeaderTextBlockStyle"
        BasedOn="{StaticResource DisplayNumberTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="CharacterSpacing" Value="20" />
    </Style>

    <!--  One day of the paper calendar; parts are filled from code (CalendarDayCell.cs)  -->
    <Style TargetType="controls:CalendarDayCell">
        <Setter Property="Background" Value="{ThemeResource CalendarCellBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CalendarCellBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:CalendarDayCell">
                    <Grid
                        x:Name="RootGrid"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="PART_Shake" />
                        </Grid.RenderTransform>
                        <Rectangle
                            x:Name="HoverOverlay"
                            Fill="{ThemeResource SubtleFillColorSecondaryBrush}"
                            Opacity="0" />
                        <Grid x:Name="PART_Content" Padding="6,2,6,5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                x:Name="PART_DayNumber"
                                HorizontalAlignment="Left"
                                Style="{StaticResource DisplayNumberTextBlockStyle}" />
                            <TextBlock
                                x:Name="PART_Date"
                                Margin="0,5,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Foreground="{ThemeResource MutedTextBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                            <StackPanel
                                x:Name="PART_Ticks"
                                Grid.Row="1"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal"
                                Spacing="3" />
                            <TextBlock
                                x:Name="PART_Title"
                                Grid.Row="2"
                                MaxLines="2"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </Grid>
                        <!--  Bonus sticker, slightly askew like a real one; the date moves aside for it (CalendarDayCell)  -->
                        <Border
                            x:Name="PART_Bonus"
                            Height="18"
                            MinWidth="18"
                            Margin="0,4,4,0"
                            Padding="4,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{ThemeResource BonusStickerBackgroundBrush}"
                            CornerRadius="9"
                            RenderTransformOrigin="0.5,0.5"
                            Visibility="Collapsed">
                            <Border.RenderTransform>
                                <RotateTransform Angle="8" />
                            </Border.RenderTransform>
                            <TextBlock
                                x:Name="PART_BonusText"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource BonusStickerForegroundBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </Border>
                        <controls:MarkerCrossControl x:Name="PART_Cross" AutomationProperties.AccessibilityView="Raw" />
                        <Border
                            x:Name="PART_Today"
                            BorderBrush="{ThemeResource CalendarCellTodayBorderBrush}"
                            BorderThickness="2"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverOverlay.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HoverOverlay.Opacity" Value="1" />
                                        <Setter Target="HoverOverlay.Fill" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Content.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
