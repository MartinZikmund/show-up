<UserControl
    x:Class="ShowUp.Controls.MarkerSwatchDot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="32"
    Height="32"
    IsHitTestVisible="False">

    <Grid>
        <Ellipse
            x:Name="Dot"
            Stroke="{ThemeResource CalendarCellBorderBrush}"
            StrokeThickness="1">
            <Ellipse.Fill>
                <SolidColorBrush x:Name="DotFill" />
            </Ellipse.Fill>
        </Ellipse>
        <!--  Auto only: the top-left half is the paper ink, the rest the chalk  -->
        <Path x:Name="PaperHalf" Visibility="Collapsed">
            <Path.Fill>
                <SolidColorBrush x:Name="PaperHalfFill" />
            </Path.Fill>
            <Path.Data>
                <PathGeometry>
                    <PathFigure IsClosed="True" StartPoint="27.31,4.69">
                        <ArcSegment
                            IsLargeArc="False"
                            Point="4.69,27.31"
                            Size="16,16"
                            SweepDirection="Counterclockwise" />
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>
    </Grid>
</UserControl>
