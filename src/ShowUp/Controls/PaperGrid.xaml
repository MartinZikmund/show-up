<UserControl
    x:Class="ShowUp.Controls.PaperGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">

    <Grid Background="{ThemeResource PaperBackgroundBrush}">
        <Path
            x:Name="Lines"
            Stroke="{ThemeResource PaperGridLineBrush}"
            StrokeThickness="1" />
    </Grid>
</UserControl>
