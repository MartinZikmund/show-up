<UserControl
    x:Class="ShowUp.Controls.ProgramCalendarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ShowUp.Controls"
    xmlns:markup="using:ShowUp.Markup"
    xmlns:vm="using:ShowUp.Core.ViewModels">

    <Grid x:Name="RootGrid">
        <ScrollViewer x:Name="Scroller" Visibility="{x:Bind ViewModel.HasEnrollment, Mode=OneWay}">
            <StackPanel
                x:Name="ContentPanel"
                MaxWidth="1040"
                Padding="{StaticResource PagePadding}"
                HorizontalAlignment="Left"
                Spacing="8">

                <!--  Header: program, streak, shift schedule  -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock
                            AutomationProperties.AutomationId="CalendarProgramName"
                            AutomationProperties.HeadingLevel="Level1"
                            Style="{StaticResource SectionHeaderTextBlockStyle}"
                            Text="{x:Bind ViewModel.ProgramName, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ShowProgramTitle, Mode=OneWay}" />
                        <!--  Several programs: the switcher is the title  -->
                        <ComboBox
                            MinWidth="240"
                            AutomationProperties.AutomationId="CalendarProgramSwitcher"
                            AutomationProperties.Name="{markup:Localize Key=ProgramSwitcherLabel}"
                            DropDownOpened="ProgramSwitcher_DropDownOpened"
                            FontFamily="{StaticResource DisplayFontFamily}"
                            FontSize="28"
                            FontWeight="SemiBold"
                            ItemsSource="{x:Bind ViewModel.Programs, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedProgram, Mode=TwoWay}"
                            Visibility="{x:Bind ViewModel.ShowProgramSwitcher, Mode=OneWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProgramOption">
                                    <TextBlock Text="{x:Bind Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <StackPanel
                            AutomationProperties.AutomationId="CalendarStreak"
                            Orientation="Horizontal"
                            Spacing="8">
                            <!--  Vector flame (no emoji font on WebAssembly), the cross moment caption's shape  -->
                            <Path
                                Height="18"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                Data="M8,0 C9,3.2 13,5.4 13,10 C13,13.6 10.8,16 8,16 C5.2,16 3,13.8 3,10.8 C3,8.4 4.2,6.8 5.6,5.6 C5.6,7.6 6.4,8.8 7.4,9.2 C6.8,6 7.6,2.8 8,0 Z M8,16 C6.6,16 5.6,14.9 5.6,13.5 C5.6,12.2 6.4,11.3 7.2,10.6 C7.3,11.6 7.9,12.2 8.6,12.4 C8.5,11.4 8.9,10.5 9.6,9.8 C10.1,10.9 10.4,12.1 10.4,13.3 C10.4,14.8 9.4,16 8,16 Z"
                                Fill="{ThemeResource MarkerBrush}"
                                Stretch="Uniform" />
                            <TextBlock
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="CalendarCurrentStreak"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind ViewModel.StreakText, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="CalendarLongestStreak"
                                Foreground="{ThemeResource MutedTextBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind ViewModel.LongestStreakText, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Margin="0,8,0,0"
                        VerticalAlignment="Top"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            AutomationProperties.AutomationId="CalendarResultsButton"
                            AutomationProperties.Name="{markup:Localize Key=CalendarResults}"
                            Command="{x:Bind ViewModel.OpenResultsCommand, Mode=OneWay}"
                            ToolTipService.ToolTip="{markup:Localize Key=CalendarResults}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE9D2;" />
                                <TextBlock x:Name="ResultsButtonText" Text="{markup:Localize Key=CalendarResults}" />
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.AutomationId="CalendarProgramNotesButton"
                            AutomationProperties.Name="{markup:Localize Key=CalendarProgramNotes}"
                            Command="{x:Bind ViewModel.EditProgramNoteCommand, Mode=OneWay}"
                            ToolTipService.ToolTip="{markup:Localize Key=CalendarProgramNotes}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE70B;" />
                                <TextBlock x:Name="NotesButtonText" Text="{markup:Localize Key=CalendarProgramNotes}" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="ShiftButton"
                            AutomationProperties.AutomationId="ShiftScheduleButton"
                            AutomationProperties.Name="{markup:Localize Key=CalendarShiftSchedule}"
                            Command="{x:Bind ViewModel.ShiftScheduleCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.IsEditable, Mode=OneWay}"
                            ToolTipService.ToolTip="{markup:Localize Key=CalendarShiftSchedule}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE823;" />
                                <TextBlock x:Name="ShiftButtonText" Text="{markup:Localize Key=CalendarShiftSchedule}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!--  Lapsed Pro: shown, not crossed  -->
                <Border
                    Padding="12"
                    BorderBrush="{ThemeResource CalendarCellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Visibility="{x:Bind ViewModel.IsReadOnly, Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock
                            AutomationProperties.AutomationId="CalendarReadOnly"
                            Foreground="{ThemeResource MutedTextBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{markup:Localize Key=ProgramReadOnlyMessage}"
                            TextWrapping="Wrap" />
                        <controls:ProGateHint Command="{x:Bind ViewModel.OpenProCommand, Mode=OneWay}" Text="{markup:Localize Key=ProMultiProgramLink}" />
                    </StackPanel>
                </Border>

                <!--  Every required session is crossed; finishing is offered, never automatic  -->
                <InfoBar
                    Title="{markup:Localize Key=CalendarFinishTitle}"
                    AutomationProperties.AutomationId="CalendarFinishBanner"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.CanFinish, Mode=OneWay}"
                    Message="{markup:Localize Key=CalendarFinishMessage}"
                    Severity="Success">
                    <InfoBar.ActionButton>
                        <Button
                            AutomationProperties.AutomationId="CalendarFinishButton"
                            Command="{x:Bind ViewModel.FinishCommand, Mode=OneTime}"
                            Content="{markup:Localize Key=FinishProgram}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <ItemsRepeater
                    x:Name="WeeksRepeater"
                    ElementClearing="WeeksRepeater_ElementClearing"
                    ElementPrepared="WeeksRepeater_ElementPrepared"
                    GettingFocus="WeeksRepeater_GettingFocus"
                    ItemsSource="{x:Bind ViewModel.Weeks, Mode=OneWay}"
                    KeyDown="WeeksRepeater_KeyDown"
                    TabFocusNavigation="Once">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:CalendarWeekViewModel">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    Margin="0,16,0,4"
                                    AutomationProperties.HeadingLevel="Level2"
                                    Style="{StaticResource CalendarPhaseHeaderTextBlockStyle}"
                                    Text="{x:Bind PhaseName, Mode=OneTime}"
                                    Visibility="{x:Bind IsPhaseStart, Mode=OneTime}" />
                                <TextBlock
                                    Foreground="{ThemeResource MutedTextBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind WeekLabel, Mode=OneTime}" />
                                <controls:CalendarWeekCells Days="{x:Bind Days, Mode=OneTime}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <!--  No enrollment yet  -->
        <StackPanel
            MaxWidth="400"
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}">
            <TextBlock
                AutomationProperties.AutomationId="CalendarEmptyTitle"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource SectionHeaderTextBlockStyle}"
                Text="{markup:Localize Key=CalendarEmptyTitle}"
                TextAlignment="Center" />
            <TextBlock
                Foreground="{ThemeResource MutedTextBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{markup:Localize Key=CalendarEmptyMessage}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="CalendarBrowseProgramsButton"
                Command="{x:Bind ViewModel.BrowseProgramsCommand, Mode=OneWay}"
                Content="{markup:Localize Key=CalendarBrowsePrograms}"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentPanel.Padding" Value="16,12,16,24" />
                        <Setter Target="ShiftButtonText.Visibility" Value="Collapsed" />
                        <Setter Target="ResultsButtonText.Visibility" Value="Collapsed" />
                        <Setter Target="NotesButtonText.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
