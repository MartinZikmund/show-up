<UserControl
    x:Class="ShowUp.Controls.ProgramHero"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!--  Text sits on the accent gradient, so it is white in both themes  -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="HeroTitleBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HeroCaptionBrush" Color="#D9FFFFFF" />
                    <SolidColorBrush x:Key="HeroShadowBrush" Color="#59000000" />
                    <SolidColorBrush x:Key="HeroFrameBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="HeroFrameBorderBrush" Color="Transparent" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="HeroTitleBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HeroCaptionBrush" Color="#D9FFFFFF" />
                    <SolidColorBrush x:Key="HeroShadowBrush" Color="#59000000" />
                    <SolidColorBrush x:Key="HeroFrameBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="HeroFrameBorderBrush" Color="Transparent" />
                </ResourceDictionary>
                <!--  High contrast drops the gradient for plain system colours  -->
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="HeroTitleBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="HeroCaptionBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <SolidColorBrush x:Key="HeroShadowBrush" Color="Transparent" />
                    <StaticResource x:Key="HeroFrameBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="HeroFrameBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid MinHeight="120">
        <Border
            Background="{ThemeResource HeroFrameBrush}"
            BorderBrush="{ThemeResource HeroFrameBorderBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}" />

        <Grid x:Name="DecorLayers">
            <Border x:Name="Backdrop" CornerRadius="{ThemeResource OverlayCornerRadius}" />

            <!--  Darkens the lower half so the white title reads on any accent  -->
            <Border CornerRadius="{ThemeResource OverlayCornerRadius}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Offset="0.35" Color="#00000000" />
                        <GradientStop Offset="1" Color="#66000000" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <StackPanel
            Padding="16,12"
            VerticalAlignment="Bottom"
            Spacing="0">
            <TextBlock
                x:Name="FamilyText"
                Foreground="{ThemeResource HeroCaptionBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Family, Mode=OneWay}" />
            <Grid>
                <TextBlock
                    Margin="0,2,0,0"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="{x:Bind TitleFontSize, Mode=OneWay}"
                    Foreground="{ThemeResource HeroShadowBrush}"
                    IsHitTestVisible="False"
                    Style="{StaticResource SectionHeaderTextBlockStyle}"
                    Text="{x:Bind ProgramName, Mode=OneWay}" />
                <TextBlock
                    x:Name="NameText"
                    FontSize="{x:Bind TitleFontSize, Mode=OneWay}"
                    Foreground="{ThemeResource HeroTitleBrush}"
                    Style="{StaticResource SectionHeaderTextBlockStyle}"
                    Text="{x:Bind ProgramName, Mode=OneWay}" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
