<UserControl
    x:Class="ShowUp.Controls.ProgramHero"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid MinHeight="120">
        <Border x:Name="Backdrop" CornerRadius="{ThemeResource OverlayCornerRadius}" />

        <!--  Darkens the lower half so the white title reads on any accent  -->
        <Border CornerRadius="{ThemeResource OverlayCornerRadius}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Offset="0.35" Color="#00000000" />
                    <GradientStop Offset="1" Color="#66000000" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <StackPanel
            Padding="16,12"
            VerticalAlignment="Bottom"
            Spacing="0">
            <TextBlock
                x:Name="FamilyText"
                Foreground="#D9FFFFFF"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Family, Mode=OneWay}" />
            <Grid>
                <TextBlock
                    Margin="0,2,0,0"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="{x:Bind TitleFontSize, Mode=OneWay}"
                    Foreground="#59000000"
                    IsHitTestVisible="False"
                    Style="{StaticResource SectionHeaderTextBlockStyle}"
                    Text="{x:Bind ProgramName, Mode=OneWay}" />
                <TextBlock
                    x:Name="NameText"
                    FontSize="{x:Bind TitleFontSize, Mode=OneWay}"
                    Foreground="White"
                    Style="{StaticResource SectionHeaderTextBlockStyle}"
                    Text="{x:Bind ProgramName, Mode=OneWay}" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
