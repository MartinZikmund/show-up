<Project>

    <!--
        Worktree-scoped app identity — APPLICATION.

        WorktreeIdentity.props derives the tags; this file applies them. It lives in .targets
        (imported AFTER the project body) because the suffix must be layered on top of the
        ApplicationId/ApplicationTitle that ShowUp.csproj sets per AppChannel.

        Full documentation: docs/worktree-identity.md
    -->

    <!-- Identity suffix. ApplicationPublisher is deliberately NOT touched: it must keep matching
         the signing certificate subject used by package-windows.yml. Icons are not touched either
         (UnoIconBackgroundFile must stay constant or Android's @mipmap/icon breaks). -->
    <PropertyGroup Condition="'$(_WorktreeIdentityAllowed)' == 'true'">
        <ApplicationId>$(ApplicationId).$(_WtIdSegment)</ApplicationId>
        <!-- MSIX uap:DefaultTile/@ShortName is capped at 40 chars. The tag gets what the title and " ()" leave. -->
        <_WtTitleRoom>$([MSBuild]::Subtract(37, $(ApplicationTitle.Length)))</_WtTitleRoom>
        <_WtTitleTag Condition="$(_WtTitleRoom) &gt;= $(_WtLongTag.Length)">$(_WtLongTag)</_WtTitleTag>
        <_WtTitleTag Condition="'$(_WtTitleTag)' == '' and $(_WtTitleRoom) &gt; 0">$(_WtLongTag.Substring(0, $(_WtTitleRoom)))</_WtTitleTag>
        <ApplicationTitle Condition="'$(_WtTitleTag)' != ''">$(ApplicationTitle) ($(_WtTitleTag))</ApplicationTitle>
    </PropertyGroup>

    <!--
        Generates AppEnvironment.WorktreeName so the running app can show which worktree it came
        from. AppEnvironment can carry an #if flag but not a string, hence generation.

        The worktree stamp is part of the OUTPUT PATH on purpose. With only
        Inputs="$(MSBuildAllProjects)" the target would be SKIPPED whenever no project file is
        newer than the output — but the name can change without touching any project file
        (git worktree move, or -p:AppWorktreeName=). The stale constant would then survive in obj/
        and the About card would lie about which package is installed.
    -->
    <!-- XamlPreCompile is load-bearing: the WinAppSDK head runs a full C# compile pass under that
         target BEFORE CoreCompile, so hooking only BeforeCompile/CoreCompile builds the Windows
         head without the generated constant and fails with CS0117. -->
    <Target Name="GenerateWorktreeInfo"
            Condition="'$(MSBuildProjectName)' == 'ShowUp'"
            BeforeTargets="BeforeCompile;CoreCompile;XamlPreCompile">
        <PropertyGroup>
            <_WtStamp Condition="'$(_WorktreeIdentityAllowed)' == 'true'">$(_WtIdSegment)</_WtStamp>
            <_WtStamp Condition="'$(_WtStamp)' == ''">none</_WtStamp>
            <_WorktreeInfoFile>$(IntermediateOutputPath)AppEnvironment.Worktree.$(_WtStamp).g.cs</_WorktreeInfoFile>
            <_WtNameForCode Condition="'$(_WorktreeIdentityAllowed)' == 'true'">$(_WtDisp)</_WtNameForCode>
        </PropertyGroup>

        <WriteLinesToFile File="$(_WorktreeInfoFile)"
                          Overwrite="true"
                          WriteOnlyWhenDifferent="true"
                          Lines="// &lt;auto-generated /&gt;;namespace ShowUp.Infrastructure%3B;;public static partial class AppEnvironment;{;    /// &lt;summary&gt;Git worktree this build came from, or empty for the main checkout.&lt;/summary&gt;;    public const string WorktreeName = &quot;$(_WtNameForCode)&quot;%3B;}" />

        <ItemGroup>
            <Compile Include="$(_WorktreeInfoFile)" />
            <FileWrites Include="$(_WorktreeInfoFile)" />
        </ItemGroup>
    </Target>

    <!-- Toast activation CLSID per package identity (UUIDv5 of ApplicationId): Dev, Prod and every worktree build
         register their own COM server, so a toast click never activates another installed build.
         Package.appxmanifest keeps a placeholder GUID; both places that name it are rewritten in the output. -->
    <UsingTask TaskName="NameBasedGuid"
               TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <Name ParameterType="System.String" Required="true" />
            <Guid ParameterType="System.String" Output="true" />
        </ParameterGroup>
        <Task>
            <Code Type="Fragment" Language="cs"><![CDATA[
                // RFC 4122 version 5 in the URL namespace.
                var ns = new byte[] { 0x6b, 0xa7, 0xb8, 0x11, 0x9d, 0xad, 0x11, 0xd1, 0x80, 0xb4, 0x00, 0xc0, 0x4f, 0xd4, 0x30, 0xc8 };
                var name = System.Text.Encoding.UTF8.GetBytes("showup-toast-activator:" + Name);
                var input = new byte[ns.Length + name.Length];
                System.Buffer.BlockCopy(ns, 0, input, 0, ns.Length);
                System.Buffer.BlockCopy(name, 0, input, ns.Length, name.Length);
                byte[] hash;
                using (var sha1 = System.Security.Cryptography.SHA1.Create()) { hash = sha1.ComputeHash(input); }
                var b = new byte[16];
                System.Array.Copy(hash, b, 16);
                b[6] = (byte)((b[6] & 0x0F) | 0x50);
                b[8] = (byte)((b[8] & 0x3F) | 0x80);
                var hex = System.BitConverter.ToString(b).Replace("-", "");
                Guid = (hex.Substring(0, 8) + "-" + hex.Substring(8, 4) + "-" + hex.Substring(12, 4) + "-" + hex.Substring(16, 4) + "-" + hex.Substring(20)).ToUpperInvariant();
            ]]></Code>
        </Task>
    </UsingTask>

    <Target Name="StampToastActivatorClsid"
            Condition="'$(MSBuildProjectName)' == 'ShowUp' and '$(TargetPlatformIdentifier)' == 'windows'"
            AfterTargets="UnoGeneratePackageAppxManifest">
        <NameBasedGuid Name="$(ApplicationId)">
            <Output TaskParameter="Guid" PropertyName="_ToastActivatorClsid" />
        </NameBasedGuid>
        <PropertyGroup>
            <_ToastManifest>@(AppxManifest)</_ToastManifest>
            <_ToastNs>&lt;Namespace Prefix='d' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;&lt;Namespace Prefix='desktop' Uri='http://schemas.microsoft.com/appx/manifest/desktop/windows10' /&gt;&lt;Namespace Prefix='com' Uri='http://schemas.microsoft.com/appx/manifest/com/windows10' /&gt;</_ToastNs>
        </PropertyGroup>
        <Error Condition="'$(_ToastManifest)' == '' or !Exists('$(_ToastManifest)')"
               Text="StampToastActivatorClsid: could not locate the generated AppxManifest (@(AppxManifest))." />
        <XmlPoke XmlInputPath="$(_ToastManifest)"
                 Query="//desktop:ToastNotificationActivation/@ToastActivatorCLSID"
                 Value="$(_ToastActivatorClsid)"
                 Namespaces="$(_ToastNs)" />
        <XmlPoke XmlInputPath="$(_ToastManifest)"
                 Query="//com:ExeServer[@Arguments='----AppNotificationActivated:']/com:Class/@Id"
                 Value="$(_ToastActivatorClsid)"
                 Namespaces="$(_ToastNs)" />
        <Message Importance="normal" Text="Toast activator CLSID for $(ApplicationId): $(_ToastActivatorClsid)" />
    </Target>

    <!-- WebAssembly: surface the derived per-worktree dev-server port. The launch profiles are
         tracked files, so they are deliberately not rewritten — per-worktree edits to them are
         exactly the recurring-merge-conflict pattern .claude/rules/docs.md exists to prevent. -->
    <Target Name="ReportWorktreeDevPort"
            Condition="'$(_WorktreeIdentityAllowed)' == 'true' and '$(TargetPlatformIdentifier)' == 'browserwasm'"
            AfterTargets="Build">
        <Message Importance="High"
                 Text="Worktree '$(AppWorktreeName)': serve this head on its own origin with --urls http://localhost:$(_WtDevPort) (port 5000 is reserved for the main checkout)." />
    </Target>

</Project>
